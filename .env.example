# Copy to .env.local and fill in your key:
#   cp .env.example .env.local
#
# Required for live analysis of an arbitrary transcript.
# If this is empty, Load Demo Transcript still runs the canned fixture.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini when unset.
OPENAI_MODEL=gpt-4o-mini

# Required only when a company website is filled in on Analyze Meeting.
# Use the Direct API access key from the Bright Data Web Unlocker zone.
BRIGHTDATA_API_KEY=

# Zone from the Bright Data sample request. Change this if your zone name differs.
BRIGHTDATA_ZONE=web_unlocker1
